{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "D:/", "effect": "allow" },
    { "action": "external_directory", "resource": "D:/*", "effect": "allow" },
    { "action": "read", "resource": "D:/*", "effect": "allow" },
    { "action": "edit", "resource": "D:/*", "effect": "allow" },
  ],
  "plugins": [
    {
      "package": "./local-plugins/goal-mode",
      "options": {
        "auto_continue": true,
        "max_auto_turns": 0,
        "max_no_progress_turns": 0,
        "max_prompt_failures": 0,
        "defer_while_tasks_active": true,
        "max_task_block_seconds": 3600,
        "min_continue_interval_seconds": 0,
      },
    },
  ],
}
